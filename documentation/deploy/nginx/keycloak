server {

	server_name keycloak.paradisoft.site;
	
	root /var/www/html/keycloak;
	index index.html;

	#	auth_basic "Administración de Keycloak";
	#auth_basic_user_file /etc/nginx/conf.d/.htpasswd;

	location / {
		set $proxy_no_disponible 0; # Valor por defecto, disponible
		# First attempt to serve request as file, then
		# as directory, then fall back to displaying a 404.
		#try_files $uri $uri/ =404;
		proxy_pass http://localhost:3703;
		error_page 502 503 504 = @fallback;
		add_header Content-Security-Policy "frame-src *; frame-ancestors *; object-src *;";
	        #add_header Access-Control-Allow-Origin '*'; 
		#add_header Access-Control-Allow-Credentials true;
		proxy_set_header Host $http_host;
	        proxy_set_header X-Real-IP $remote_addr;
        	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	        proxy_set_header X-Forwarded-Host $http_host;
	        proxy_set_header X-Forwarded-Proto $scheme;
	}


	location @fallback {
		try_files /maintenance.html =404;
		auth_basic off; # Para que no herede desde el servidor
	}

	# Proxy static files to the Keycloak container (images, CSS, JS, etc.)
    	location ~* \.(jpg|jpeg|png|gif|webp|css|js|ico|html)$ {
        	proxy_pass http://localhost:3703;  # Proxy static files to Keycloak
		add_header Content-Security-Policy "frame-src *; frame-ancestors *; object-src *;";
	        add_header Access-Control-Allow-Origin '*'; 
		add_header Access-Control-Allow-Credentials true;
		proxy_set_header Host $http_host;
	        proxy_set_header X-Real-IP $remote_addr;
        	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	        proxy_set_header X-Forwarded-Host $http_host;
	        proxy_set_header X-Forwarded-Proto $scheme;
        	error_page 404 = @fallback;  # Fallback in case static files are missing
		auth_basic off; # Para que no herede desde el servidor
    }		
	


    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/keycloak.paradisoft.site/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/keycloak.paradisoft.site/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

server {
    if ($host = keycloak.paradisoft.site) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	listen 80;
	listen [::]:80;

	server_name keycloak.paradisoft.site;
    return 404; # managed by Certbot


}
